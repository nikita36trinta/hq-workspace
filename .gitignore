node_modules/
.rigid/

# Central runtime dir (.hq/_runtime/) — ephemeral contents, keep the dir itself
# tracked so the canonical path always exists after a fresh clone.
.hq/_runtime/*
!.hq/_runtime/.gitkeep
.runtime/
.DS_Store
registrant.env

# Боевые ключи проектов. Рядом с каждым compose лежит .env.example с перечнем
# переменных — он в репозитории, сами значения нет.
.env
**/.env
