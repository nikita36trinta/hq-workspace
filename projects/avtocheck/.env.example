# Образец окружения для ЧистаяСделка Авто.
# Скопировать в .env рядом с docker-compose.yml и подставить боевые значения.
# Сам .env в репозиторий не попадает — см. .gitignore.

# Источник данных об автомобилях (apipoint.ru, оплата с баланса).
APIPOINT_TOKEN=

# Транзакционная почта (Unisender Go).
UNISENDER_GO_API_KEY=

# ЮKassa. Магазин общий с недвижимостью, разделение — по метке кампании.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Вердикт: OpenRouter через иностранный прокси (сервер в РФ).
OPENROUTER_API_KEY=
LLM_PROXY=

# Служебное: админка и бот-сторож недоставленных оплат.
ADMIN_TOKEN=
ADMIN_TG_CODE=
BOT_TOKEN=
OWNER_TG_CHAT_ID=

# Метрика: токен нужен для офлайн-конверсий (атрибуция оплат после ЮKassa).
YANDEX_METRIKA_TOKEN=
