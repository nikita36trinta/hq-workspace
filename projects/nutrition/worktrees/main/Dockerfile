FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py auth.py plan.py plan_ai.py dish_photos.py dishes.json ./
COPY static ./static
ENV DATA_DIR=/app/data
EXPOSE 8790
# --no-proxy-headers обязателен, и вот почему. ProxyHeaders-мидлварь uvicorn
# берёт из X-Forwarded-For ЛЕВЫЙ элемент цепочки, а левый элемент подставляет
# клиент: nginx с $proxy_add_x_forwarded_for дописывает настоящий адрес СПРАВА,
# к тому, что прислали. То есть при включённой мидлвари любой посетитель
# назначает себе адрес одной строкой заголовка и обходит все наши лимиты.
# Замерено: с включённой мидлварью в журнал ложится подставной 9.9.9.9.
# Отключаем её и разбираем заголовок сами (_client_ip в app.py) — там берётся
# ПРАВЫЙ элемент и только от доверенного пира из NUTRI_TRUSTED_PROXIES.
#
# ЭТУ ПЕРЕМЕННУЮ НАДО ЗАДАТЬ, если перед приложением стоит обратный прокси, —
# иначе заголовку не верят вообще и ВСЕ посетители считаются одним адресом:
# лимиты (20 лидов, 15 писем восстановления, 20 входов в час) становятся общими
# на весь сайт, а поле ip в журнале согласий у всей базы одинаковое.
# Значение — адрес, с которого приходит соединение ОТ прокси. Его называет
# однократный [ALERT] в логе при первом же запросе с X-Forwarded-For; для
# docker-публикации это обычно адрес шлюза сети (172.17.0.1 / 192.168.65.1),
# для прокси на том же хосте — 127.0.0.1. Можно перечислить через запятую.
# Пустое значение оставлено намеренно: умолчание «доверять приватным сетям» я
# пробовал, и оно доверяло КАЖДОМУ клиенту (пир — шлюз докера, он приватный).
ENV NUTRI_TRUSTED_PROXIES=""
# X-Forwarded-Proto разбирается там же (_notrack_mw): без него base_url всегда
# http://, и на нём собираются return_url для ЮKassa и ссылки в письмах.
CMD ["uvicorn","app:app","--host","0.0.0.0","--port","8790","--no-proxy-headers"]
